    {
      "id": "d4edb5ca-33ec-4d7d-8197-7ae88ffa87df",
      "text": "The app must be ready to update for another user after receiving new user data from any of three ingest shapes: Garmin account export (file, full history, no vendor API), Google Health export (file, full history), or Google Health live connection (incremental, on top of either). | Involving: another user | To ensure app readiness for updates from diverse data sources.",
      "type": "world",
      "entities": [
        "Garmin account export",
        "Google Health live connection",
        "Google Health export",
        "another user",
        "app"
      ],
      "context": "decision record: database-architecture",
