    {
      "id": "44e3e57d-2cdd-4128-97f7-1567ca18b8cf",
      "text": "Evidence hierarchy shows timing is essentially exact but buried in products, sleep/wake detection has moderate sensitivity but low specificity (29-52%) yet shown as efficiency, 4-stage architecture has variable agreement (kappa 0.21-0.68) yet used as hypnogram centrepiece, composite scores lack validation yet are headline numbers.",
      "type": "world",
      "entities": [
        "4-stage architecture",
        "timing",
        "composite score",
        "products",
        "sleep/wake detection"
      ],
      "context": "investigation report: hz-compete",
      "occurred_start": null,
      "occurred_end": null,
      "mentioned_at": "2026-08-20T04:55:08.743433+00:00",
