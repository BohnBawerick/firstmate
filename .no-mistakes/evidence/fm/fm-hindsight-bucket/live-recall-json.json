      ],
      "source_fact_ids": null
    },
    {
      "id": "bdf72790-5f40-4ec2-afc2-713d8cb9d6fe",
      "text": "Normalise every stream onto one clock at import before derivation, rather than correcting per-stream at read time; import entire dataset first then filter to find relevant data. | Involving: firstmate (AI agent) | To simplify ingest architecture and avoid per-stream corrections.",
      "type": "experience",
      "entities": [
        "clock",
        "fresh database",
        "firstmate"
      ],
      "context": "decision record: round2-review",
      "occurred_start": null,
      "occurred_end": null,
