    {
      "id": "1a8560dd-79d4-4f04-b20f-6bc60bb1eea4",
      "text": "Decided consequences: store.py remains the only write path; source is part of row identity allowing two sources covering one night to coexist as two rows; overlap resolved at read time via union then richest record wins; every write is an idempotent upsert enabling safe cheap re-import of whole archives. | Involving: firstmate (AI agent) | To maintain stable and reliable database architecture.",
      "type": "world",
      "entities": [
        "upsert",
        "store.py",
        "source column",
        "Healthlog",
        "row identity"
      ],
      "context": "decision record: database-architecture",
      "occurred_start": null,
      "occurred_end": null,
